import * as T from 'three';
import {surface,glassMaterial} from './surface-materials.js';
import {outsideRectangle} from './caretaker-house.js';
import {makeWaterMaterial} from './water-material.js';

// Flat 1.02 in the former indoor pool hall. The old basin is kept and reused as
// the flat's own 7.6 x 2.6 m indoor pool between the living zone and the
// bedrooms. Living room, dining and kitchen face south over the front garden
// (model -z), bedrooms and bathroom face the north courtyard, entrance hall
// from the north walkway. Kitchen, bathroom and pool plant share the wet wall
// at the east end next to the existing riser.
export const apartment={x0:-19.63,x1:-4.79,z0:-21.44,z1:-11.20,entry:{x:-6.8,z:-12.2},
 pool:{x0:-17.8,x1:-10.2,z0:-17.95,z1:-15.35,water:.4,rim:.45}};
const rect=(a,b,c,d)=>[[a,b],[c,b],[c,d],[a,d]];
export function applyPoolApartment(data){
 const d=data[0];
 const mask={x0:-19.62,x1:-4.781,z0:-21.44,z1:-11.2};
 d.walls=d.walls.flatMap(p=>outsideRectangle(p,mask));
 d.doors=d.doors.filter(p=>!(p.hinge[0]>mask.x0&&p.hinge[0]<mask.x1&&p.hinge[1]>mask.z0&&p.hinge[1]<mask.z1));
 const wall=(axis,f,a,b,gaps=[],t=.14)=>{let start=a;for(const [lo,hi] of [...gaps,[b,b]]){if(lo>start)d.walls.push(axis==='x'?rect(start,f-t/2,lo,f+t/2):rect(f-t/2,start,f+t/2,lo));start=hi}};
 const door=(name,hinge,closed,open)=>d.doors.push({name:'Byt 1.02 · '+name,hinge,closed,open,width:Math.hypot(closed[0]-hinge[0],closed[1]-hinge[1]),height:2.18});
 // Bedroom wing along the north facade.
 wall('x',-14.55,-19.63,-7.85,[[-17.3,-16.4],[-12.9,-12.0],[-9.65,-8.95]]);
 wall('z',-15.0,-14.55,-11.2);wall('z',-10.55,-14.55,-11.2);wall('z',-7.85,-14.55,-11.2,[[-13.9,-13.0]]);
 door('spálňa',[-17.28,-14.55],[-16.42,-14.55],[-17.28,-13.69]);
 door('izba',[-12.88,-14.55],[-12.02,-14.55],[-12.88,-13.69]);
 door('kúpeľňa',[-9.63,-14.55],[-8.97,-14.55],[-9.63,-13.89]);
 door('technika bazéna',[-7.85,-13.88],[-7.85,-13.02],[-8.71,-13.88]);
}
export const apartmentFurniture=[];
export function apartmentBarrierAt(x,z,y){return y>-.15&&y<2&&apartmentFurniture.some(r=>x>r[0]-.16&&x<r[2]+.16&&z>r[1]-.16&&z<r[3]+.16)};
export function buildPoolApartment(){
 const g=new T.Group();g.name='Byt 1.02 s vlastným bazénom v bývalej bazénovej hale';apartmentFurniture.length=0;
 const a=apartment,p=a.pool,wood=surface('wood'),oak=wood.clone();oak.color.set(0xb08a63);
 const white=new T.MeshStandardMaterial({color:0xf2f1ec,roughness:.3}),cream=new T.MeshStandardMaterial({color:0xebe7dc,roughness:.9});
 const fabric=new T.MeshStandardMaterial({color:0x52656a,roughness:.95}),dark=new T.MeshStandardMaterial({color:0x2a2f31,roughness:.5,metalness:.2});
 const stone=new T.MeshStandardMaterial({color:0xcfc8ba,roughness:.5}),mosaic=new T.MeshStandardMaterial({color:0x6fa2a8,roughness:.25});
 const steel=new T.MeshStandardMaterial({color:0xa9b0b2,metalness:.85,roughness:.25}),lamp=new T.MeshStandardMaterial({color:0xfff1d6,emissive:0xffdcaa,emissiveIntensity:.6});
 const glass=glassMaterial();
 const box=(name,x,y,z,sx,sy,sz,m,solid=false)=>{const o=new T.Mesh(new T.BoxGeometry(sx,sy,sz),m);o.position.set(x,y,z);o.name=name;o.castShadow=sy>.08&&!m.transparent;o.receiveShadow=true;g.add(o);if(solid)apartmentFurniture.push([x-sx/2,z-sz/2,x+sx/2,z+sz/2]);return o};
 box('Dubová podlaha bytu',(a.x0+a.x1)/2,.012,-17.8,a.x1-a.x0-.04,.024,7.2,oak);
 // Indoor pool in the original basin: stone coping, mosaic, steps, glass balustrade.
 {const cx=(p.x0+p.x1)/2,cz=(p.z0+p.z1)/2,L=p.x1-p.x0,W=p.z1-p.z0,r=.35;
  box('Lem bazéna',cx,p.rim/2,p.z0-r/2,L+2*r,p.rim,r,stone,true);box('Lem bazéna',cx,p.rim/2,p.z1+r/2,L+2*r,p.rim,r,stone,true);
  box('Lem bazéna',p.x0-r/2,p.rim/2,cz,r,p.rim,W,stone,true);box('Lem bazéna',p.x1+r/2,p.rim/2,cz,r,p.rim,W,stone,true);
  box('Mozaika bazéna',cx,.2,cz,L,.02,W,mosaic);apartmentFurniture.push([p.x0,p.z0,p.x1,p.z1]);
  const water=new T.Mesh(new T.PlaneGeometry(L,W),makeWaterMaterial(false));water.rotation.x=-Math.PI/2;water.position.set(cx,p.water,cz);water.name='Vodná hladina bazéna v byte';g.add(water);
  for(let i=0;i<3;i++)box('Schod do bazéna',p.x1-.35-i*.3,.32-i*.1,cz,.3,.06,W-.1,stone);
  box('Sklenené zábradlie bazéna',cx,.95,p.z0-r,L,.9,.012,glass);
  box('Podsvietenie bazéna',cx,.36,p.z1,L-.4,.02,.02,lamp);
  for(const x of [-9.4,-8.6]){box('Ležadlo pri bazéne',x,.3,-16.65,.7,.12,1.9,white,true);box('Operadlo ležadla',x,.55,-17.45,.66,.45,.08,white)}
  box('Strešný svetlík nad bazénom',cx,2.52,cz,L-.6,.02,W-.4,lamp)}
 // South zone: living room, dining, kitchen with island (all facing the garden).
 box('Pohovka',-17.2,.4,-20.6,2.8,.8,.95,fabric,true);box('Opierka pohovky',-18.9,.55,-19.9,.9,.5,2.1,fabric,true);
 box('Konferenčný stolík',-17.0,.38,-19.3,1.2,.06,.7,wood,true);box('TV stena',-19.55,1.2,-19.4,.08,1.1,2.0,dark);box('Koberec',-17.4,.03,-19.7,3.4,.01,2.6,cream);
 box('Jedálenský stôl',-12.6,.75,-19.9,2.2,.05,1.0,wood,true);for(const dx of [-.7,0,.7])for(const sz of [-1,1])box('Jedálenská stolička',-12.6+dx,.47,-19.9+sz*.75,.45,.06,.45,dark,true);
 for(const x of [-13.2,-12.0])box('Závesné svetlo',x,2.15,-19.9,.3,.2,.3,lamp);
 box('Kuchynská linka',-6.85,.45,-21.0,4.0,.9,.62,white,true);box('Pracovná doska',-6.85,.92,-21.0,4.0,.04,.64,stone);box('Varná doska',-6.2,.945,-21.0,.75,.01,.5,dark);box('Drez',-7.9,.945,-21.0,.6,.02,.42,steel);
 box('Vysoké skrine',-5.15,1.1,-19.6,.6,2.2,2.2,white,true);box('Ostrovček',-7.4,.46,-19.45,2.2,.92,.9,oak,true);box('Doska ostrovčeka',-7.4,.94,-19.45,2.3,.04,1.0,stone);
 for(const x of [-8.1,-7.4,-6.7])box('Barová stolička',x,.65,-18.75,.38,.06,.38,dark,true);
 // Bedrooms on the courtyard side.
 box('Manželská posteľ',-17.3,.25,-12.4,1.8,.5,2.05,white,true);box('Prikrývka',-17.3,.53,-12.55,1.8,.06,1.7,cream);box('Čelo postele',-17.3,.7,-11.35,1.9,.9,.08,wood);
 box('Šatník',-19.3,1.1,-13.2,.6,2.2,2.1,white,true);
 box('Posteľ',-12.8,.25,-12.3,1.2,.5,2.0,white,true);box('Prikrývka',-12.8,.53,-12.45,1.2,.06,1.6,cream);box('Písací stôl',-14.6,.74,-12.6,.6,.05,1.3,wood,true);
 // Bathroom: walk-in shower, bathtub, double vanity, WC.
 box('Vaňa',-9.6,.3,-11.75,1.75,.6,.8,white,true);box('Sprcha',-8.45,.03,-11.75,.9,.06,.9,white);box('Sklo sprchy',-8.9,1.05,-11.75,.01,2,.9,glass);
 box('Dvojumývadlo',-9.2,.85,-14.15,1.3,.15,.5,white,true);box('WC',-10.25,.26,-13.1,.42,.52,.62,white,true);
 // Pool plant room and entrance hall with wardrobe.
 box('Filtrácia a ohrev bazéna',-7.35,.7,-11.6,.8,1.4,.6,steel,true);box('Rozvádzač',-7.3,1.4,-13.9,.5,.8,.2,white);
 box('Vstavaná skriňa v predsieni',-5.1,1.1,-13.2,.6,2.2,2.2,white,true);box('Lavica v predsieni',-5.15,.45,-11.85,.5,.06,1.0,wood);
 for(const [x,z] of [[-17,-19.7],[-7.4,-19.6],[-17.3,-12.8],[-12.8,-12.8],[-9.2,-12.9],[-6.4,-12.6]])box('Stropné svetlo',x,2.48,z,.45,.03,.45,lamp);
 return g;
}
